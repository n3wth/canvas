# Written into .env.local automatically by `npx convex dev`.
# Copy this file only if you are wiring the app to a deployment by hand.

# Convex deployment the client subscribes to.
NEXT_PUBLIC_CONVEX_URL=

# Base URL for Convex HTTP actions. Used by the source push endpoint
# (POST /canvas/source); the app itself does not need it.
NEXT_PUBLIC_CONVEX_SITE_URL=
