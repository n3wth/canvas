# Written into .env.local automatically by `npx convex dev`.
# Copy this file only if you are wiring the app to a deployment by hand.

# Convex deployment the client subscribes to.
NEXT_PUBLIC_CONVEX_URL=

# Base URL for Convex HTTP actions (.convex.site). Agent API + legacy source push.
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Convex dashboard env (not Next.js) ---
# Set these on the Convex deployment (`npx convex env set ...`), never commit values.
# CANVAS_AGENT_TOKEN=   # Bearer for /agent/v1/* when set (set on Convex, not Next)
# CANVAS_PUBLIC_ORIGIN=https://canvas.n3wth.com  # optional override for URLs in API responses
